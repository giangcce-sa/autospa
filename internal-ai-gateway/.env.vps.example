NODE_ENV=production
GATEWAY_DOMAIN=gateway.example.com
GATEWAY_PORT=8787
TRUST_PROXY=true
REQUEST_BODY_LIMIT_BYTES=8388608
MAX_MEDIA_BASE64_BYTES=6291456
PROVIDER_ALERT_COOLDOWN_SECONDS=300
LOG_LEVEL=info

DATABASE_PROVIDER=sqlite
DATABASE_URL=file:./data/gateway.db
AUDIT_LOG_PATH=./audit-logs/gateway.jsonl

ADMIN_TOKEN=replace-with-long-random-secret
ADMIN_SESSION_TTL_SECONDS=28800
KEY_PEPPER=replace-with-long-random-secret-different-from-admin-token

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_VERSION=2023-06-01

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

NINEROUTER_BASE_URL=http://nine-router:20128/v1
NINEROUTER_API_KEY=
NINEROUTER_TIMEOUT_SECONDS=90
NINEROUTER_INITIAL_PASSWORD=replace-with-long-dashboard-password
NINEROUTER_JWT_SECRET=replace-with-long-random-secret
NINEROUTER_API_KEY_SECRET=replace-with-long-random-secret
NINEROUTER_MACHINE_ID_SALT=replace-with-long-random-secret
NINEROUTER_REQUIRE_API_KEY=true
NINEROUTER_AUTH_COOKIE_SECURE=false

KIRO_API_KEY=
KIRO_CLI_BIN=kiro-cli
KIRO_WORKDIR=./kiro-workspaces/default
KIRO_TIMEOUT_SECONDS=180
KIRO_MAX_CONCURRENCY=1
KIRO_QUEUE_MAX_PENDING=10

CLAUDE_CODE_GATEWAY_KEY=
CURSOR_GATEWAY_KEY=
N8N_GATEWAY_KEY=
AI_SPA_GATEWAY_KEY=
