DIRECT_URL=postgresql://user:password@database-host:5432/autospa
ALLOW_PRODUCTION_DATABASE_BACKUP=backup:autospa
BACKUP_ENCRYPTION_KEY=replace-with-base64-or-hex-encoded-32-byte-key
BACKUP_KEY_ID=backup-key-2026-01
BACKUP_WORK_DIR=/var/lib/autospa-backup
BACKUP_S3_BUCKET=autospa-backups
BACKUP_S3_PREFIX=database
BACKUP_S3_REGION=auto
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_FORCE_PATH_STYLE=false
