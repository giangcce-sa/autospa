# Runtime và release metadata
NODE_ENV=production
AUTH_SECRET=
# Khóa mã hóa secrets trong DB (API key, access token — định dạng enc:v2).
# Tùy chọn: bỏ trống thì dùng AUTH_SECRET. Nên đặt riêng để xoay AUTH_SECRET
# không làm mất khả năng giải mã. Backfill dữ liệu cũ: node --experimental-strip-types scripts/encrypt-secrets.mjs
# SECRETS_ENCRYPTION_KEY=
AUTH_URL=https://autospa.example.com
NEXT_PUBLIC_APP_URL=https://autospa.example.com
AUTH_TRUST_HOST=true
DEPLOYMENT_ENV=production
APP_RELEASE=

# PostgreSQL (Neon) — lấy từ neon.tech > Project > Connection string
# DATABASE_URL dùng pooled connection (cho Vercel serverless)
# DIRECT_URL dùng direct connection (cho prisma migrate)
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=verify-full&pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=verify-full"
# Database riêng chỉ dùng để kiểm tra migration drift trong môi trường phát triển.
# SHADOW_DATABASE_URL="postgresql://user:password@localhost:5432/autospa_shadow"

# Media storage: local (default) or S3-compatible (AWS S3, Cloudflare R2, MinIO)
MEDIA_STORAGE_PROVIDER=local
# MEDIA_S3_BUCKET=autospa-media
# MEDIA_S3_REGION=auto
# MEDIA_S3_ENDPOINT=https://account-id.r2.cloudflarestorage.com
# MEDIA_S3_ACCESS_KEY_ID=
# MEDIA_S3_SECRET_ACCESS_KEY=
# MEDIA_S3_FORCE_PATH_STYLE=false

# Facebook Ads production safety. Mặc định chỉ đọc; chỉ tăng mode sau khi hoàn tất gate tương ứng.
ADS_EXECUTION_MODE=read_only
ADS_EMERGENCY_STOP=true
# ID nội bộ của FacebookPage trong database, phân tách bằng dấu phẩy.
ADS_ALLOWED_FACEBOOK_PAGE_IDS=
# Meta Ad Account ID, chấp nhận cả dạng 123 hoặc act_123, phân tách bằng dấu phẩy.
ADS_ALLOWED_AD_ACCOUNT_IDS=
# Host HTTPS được phép tải ảnh quảng cáo bên ngoài, phân tách bằng dấu phẩy. Media nội bộ không cần cấu hình này.
ADS_MEDIA_ALLOWED_HOSTS=
# Bắt buộc ở production cho mọi cron route.
CRON_SECRET=
# Chỉ bật rõ ràng khi kiểm thử local; không có hiệu lực ở production.
ALLOW_INSECURE_DEV_CRON=false

# Xác thực Facebook Page Access Token và chữ ký X-Hub-Signature-256.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Có thể dùng App Access Token riêng thay cho FACEBOOK_APP_ID|FACEBOOK_APP_SECRET khi chạy readiness probe.
# FACEBOOK_APP_ACCESS_TOKEN=
# Secret xác thực webhook Zalo theo hợp đồng ký HMAC-SHA256 của integration hiện tại.
ZALO_WEBHOOK_SECRET=
# Chỉ cho phép webhook không có secret ở local/test khi bật rõ ràng; không có hiệu lực ở production.
ALLOW_INSECURE_DEV_WEBHOOKS=false

# AI Video Studio. Settings chỉ có thể hạ quyền; deployment là execution ceiling authoritative.
VIDEO_EXECUTION_MODE=mock
VIDEO_EMERGENCY_STOP=true
VIDEO_MOCK_MODE=true
VIDEO_BUDGET_USD=25
# RUNWAY_API_KEY=
# RUNWAY_BASE_URL=https://api.dev.runwayml.com
# RUNWAY_VIDEO_MODEL=gen4.5
# ELEVENLABS_API_KEY=
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io
# ELEVENLABS_VOICE_MODEL=eleven_multilingual_v2
# SYNC_API_KEY=
# SYNC_BASE_URL=https://api.sync.so
# SYNC_MODEL=sync-3
# Domain gateway tùy chỉnh được phép dùng làm provider base URL, phân tách bằng dấu phẩy.
# VIDEO_PROVIDER_ALLOWED_HOSTS=ai-gateway.example.com

# Domain gateway Claude/OpenAI tùy chỉnh được phép dùng trong Cài đặt.
# Chỉ ghi hostname, không ghi giao thức hoặc đường dẫn.
# AI_PROVIDER_ALLOWED_HOSTS=ai-gateway.example.com
