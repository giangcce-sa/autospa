// ─── AI Brain Skill Models ───────────────────────────────────────────────────

model BrainSkill {
  id                       String   @id @default(cuid())
  name                     String
  description              String?
  domain                   String // sales | content | ads | intelligence | customer | operation | brand
  category                 String
  tags                     String   @default("[]") // JSON string[]
  inputSignals             String   @default("[]") // JSON string[]
  triggerType              String   @default("manual")
  triggerConfig            String   @default("{}") // JSON object
  playbook                 String
  tools                    String   @default("[]") // JSON string[]
  successMetric            String?
  permissionLevel          String   @default("suggest") // suggest | draft | supervised | auto
  riskLevel                String   @default("low") // low | medium | high
  confidence               Float    @default(0.5)
  classificationConfidence Float    @default(0.5)
  status                   String   @default("draft") // draft | active | paused | deprecated
  learnedFrom              String   @default("manual") // manual | outcome | council | user_feedback
  councilNotes             String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  versions BrainSkillVersion[]
  runs     BrainSkillRun[]
  outcomes BrainSkillOutcome[]
  feedback BrainSkillFeedback[]

  @@index([domain, status])
  @@index([category, status])
  @@index([riskLevel, status])
}

model BrainSkillVersion {
  id            String     @id @default(cuid())
  skillId       String
  skill         BrainSkill @relation(fields: [skillId], references: [id], onDelete: Cascade)
  version       Int
  playbook      String
  triggerConfig String     @default("{}")
  changeNote    String?
  createdAt     DateTime   @default(now())

  @@unique([skillId, version])
}

model BrainSkillRun {
  id          String     @id @default(cuid())
  skillId     String
  skill       BrainSkill @relation(fields: [skillId], references: [id], onDelete: Cascade)
  signal      String     @default("{}") // JSON object
  action      String
  status      String     @default("queued") // queued | drafted | executed | skipped | failed
  result      String?
  error       String?
  startedAt   DateTime   @default(now())
  completedAt DateTime?

  outcomes BrainSkillOutcome[]

  @@index([skillId, startedAt])
  @@index([status, startedAt])
}

model BrainSkillOutcome {
  id              String         @id @default(cuid())
  skillId         String
  skill           BrainSkill     @relation(fields: [skillId], references: [id], onDelete: Cascade)
  runId           String?
  run             BrainSkillRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  metric          String
  beforeValue     Float?
  afterValue      Float?
  deltaPct        Float?
  status          String         @default("pending") // pending | success | fail | neutral
  notes           String?
  confidenceDelta Float          @default(0)
  createdAt       DateTime       @default(now())

  @@index([skillId, createdAt])
  @@index([status, createdAt])
}

model BrainSkillFeedback {
  id        String     @id @default(cuid())
  skillId   String
  skill     BrainSkill @relation(fields: [skillId], references: [id], onDelete: Cascade)
  type      String // approve | edit | reject | correction | note
  field     String?
  oldValue  String?
  newValue  String?
  note      String?
  createdAt DateTime   @default(now())

  @@index([skillId, createdAt])
}

model SpaSync {
  id                String    @id @default("1")
  lastSyncAt        DateTime?
  revenueToday      Int       @default(0)
  bookingCountToday Int       @default(0)
  lastError         String?
  lastPublishRun    DateTime?
  lastAdsOptRun     DateTime?
  updatedAt         DateTime  @updatedAt
}

// ─── AI Video Studio ────────────────────────────────────────────────────────

model VideoProject {
  id               String    @id @default(cuid())
  facebookPageId   String?
  name             String
  brief            String
  objective        String    @default("awareness")
  platform         String    @default("tiktok")
  aspectRatio      String    @default("9:16")
  language         String    @default("vi")
  durationSec      Int       @default(30)
  serviceId        String?
  staffProfileId   String?
  voiceProfileId   String?
  templateId       String?
  styleSkillIds    String    @default("[]")
  styleStrength    Float     @default(0.7)
  status           String    @default("draft")
  approvalStatus   String    @default("draft")
  storyboard       String    @default("{}")
  caption          String?
  hashtags         String?
  thumbnailUrl     String?
  outputUrl        String?
  outputStorageKey String?
  qualityScore     Int?
  qualityReport    String?
  estimatedCostUsd Float     @default(0)
  actualCostUsd    Float     @default(0)
  reservedCostUsd  Float     @default(0)
  inputRevision    Int       @default(1)
  renderedRevision Int?
  approvedRevision Int?
  approvedBy       String?
  approvedAt       DateTime?
  publishedPostId  String?
  createdById      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  scenes       VideoScene[]
  assets       VideoAsset[]
  jobs         VideoJob[]
  versions     VideoVersion[]
  performances VideoPerformance[]

  @@index([facebookPageId, createdAt])
  @@index([status, updatedAt])
  @@index([approvalStatus, updatedAt])
}

model VideoScene {
  id                String       @id @default(cuid())
  projectId         String
  project           VideoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  position          Int
  title             String
  kind              String       @default("broll")
  purpose           String?
  durationSec       Int          @default(5)
  script            String       @default("")
  visualPrompt      String       @default("")
  negativePrompt    String?
  cameraDirection   String?
  staffProfileId    String?
  voiceProfileId    String?
  sourceImageUrl    String?
  sourceVideoUrl    String?
  generatedVideoUrl String?
  audioUrl          String?
  lipSyncVideoUrl   String?
  subtitleData      String       @default("[]")
  status            String       @default("draft")
  locked            Boolean      @default(false)
  provider          String?
  providerTaskId    String?
  qaScore           Int?
  qaReport          String?
  inputRevision     Int          @default(1)
  videoRevision     Int?
  audioRevision     Int?
  lipSyncRevision   Int?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  assets VideoAsset[]
  jobs   VideoJob[]

  @@unique([projectId, position])
  @@index([projectId, status])
}

model VideoAsset {
  id          String       @id @default(cuid())
  projectId   String
  project     VideoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sceneId     String?
  scene       VideoScene?  @relation(fields: [sceneId], references: [id], onDelete: SetNull)
