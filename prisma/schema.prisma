generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String           @id @default(cuid())
  email       String           @unique
  name        String?
  hashedPwd   String // bcrypt
  role        String           @default("owner") // owner | viewer
  lastLoginAt DateTime?
  createdAt   DateTime         @default(now())
  pageAccess  UserPageAccess[]
}

model UserPageAccess {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  facebookPageId String
  facebookPage   FacebookPage @relation(fields: [facebookPageId], references: [id], onDelete: Cascade)
  permission     String       @default("editor")
  createdAt      DateTime     @default(now())

  @@unique([userId, facebookPageId])
  @@index([facebookPageId, permission])
}

model RateLimit {
  id          String   @id // composite: "provider:scope"
  count       Int      @default(0)
  windowStart DateTime
  limit       Int // configured cap
  windowSec   Int // window size in seconds
  updatedAt   DateTime @updatedAt
}

model Settings {
  id                     String    @id @default("1")
  claudeApiKey           String?
  claudeBaseUrl          String    @default("https://api.anthropic.com")
  openaiApiKey           String?
  openaiBaseUrl          String    @default("https://api.openai.com/v1")
  imageModel             String    @default("dall-e-3")
  openaiChatModel        String    @default("gpt-5") // chat completion model for AI Council
  zaloToken              String?
  zaloOaId               String?
  draftRetentionDays     Int       @default(30)
  publishedRetentionDays Int       @default(90)
  webhookVerifyToken     String    @default("")
  webhookMode            String    @default("manual")
  autoReplyComments      Boolean   @default(false)
  autoReplyMessages      Boolean   @default(false)
  // Spa Software Integration
  spaApiUrl              String?
  spaApiKey              String?
  spaWebhookSecret       String?
  // Lead Handoff
  leadHandoffMode        String    @default("staff") // "link" | "api" | "staff"
  leadHandoffLink        String?
  // Automation
  automationLevel        String    @default("supervised") // "supervised" | "semi" | "full"
  zaloApprovalRecipient  String?
  // Ads Optimization Thresholds
  adsOptimizePauseCtr    Float     @default(0.5)
  adsOptimizeScaleCtr    Float     @default(2.0)
  adsOptimizeFreqLimit   Float     @default(3.0)
  adsOptimizeScalePct    Int       @default(20)
  adsOptimizeMinSpend    Int       @default(100000)
  adsOptimizeMaxBudget   Int       @default(2000000)
  adsOptimizeCooldownHrs Int       @default(24)
  adsOptimizeMinRoas     Float     @default(1.5)
  // Telegram
  telegramBotToken       String?
  telegramChatId         String?
  telegramAdminUserId    String?
  telegramAlerts         Boolean   @default(true)
  telegramWebhookSecret  String?
  telegramWebhookUrl     String?
  telegramWebhookAt      DateTime?
  // AI Video Studio providers. Secrets are server-only and masked by the settings API.
  runwayApiKey           String?
  runwayBaseUrl          String    @default("https://api.dev.runwayml.com")
  runwayVideoModel       String    @default("gen4.5")
  elevenLabsApiKey       String?
  elevenLabsBaseUrl      String    @default("https://api.elevenlabs.io")
  elevenLabsVoiceModel   String    @default("eleven_multilingual_v2")
  syncLabsApiKey         String?
  syncLabsBaseUrl        String    @default("https://api.sync.so")
  syncLabsModel          String    @default("sync-3")
  videoMockMode          Boolean   @default(true)
  videoBudgetUsd         Float     @default(25)
  weeklyReportEnabled    Boolean   @default(true)
  weeklyReportDay        Int       @default(1)
  weeklyReportHour       Int       @default(8)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

model FacebookPage {
  id                     String    @id @default(cuid())
  fbPageId               String    @unique
  pageName               String
  accessToken            String
  isActive               Boolean   @default(true)
  adAccountId            String?
  adsReadinessStatus     String    @default("unchecked")
  adsReadinessError      String?
  adsReadinessCheckedAt  DateTime?
  adsTokenExpiresAt      DateTime?
  adsDataAccessExpiresAt DateTime?
  adsPermissions         String    @default("[]")
  adsMissingPermissions  String    @default("[]")
  adAccountStatus        Int?
  adAccountDisableReason Int?
  adAccountCurrency      String?
  adAccountTimezone      String?
  // Linked Instagram Business account
  igAccountId            String? // Instagram Business Account ID (from Graph API)
  igUsername             String?
  createdAt              DateTime  @default(now())

  posts             Post[]
  bulkPlans         BulkPlan[]
  adsOperations     AdsCreateOperation[]
  publishOperations PublishOperation[]
  comments          PostComment[]
  commentRules      CommentRule[]
  inboxMessages     InboxMessage[]
  brandKit          BrandKit?
  styleProfile      StyleProfile?
  humanVoiceProfile HumanVoiceProfile?
  visualProfile     VisualProfile?
  styleSamples      StyleSample[]
  services          Service[]
  staffVisuals      StaffVisualProfile[]
  pageAccess        UserPageAccess[]
}

model TikTokAccount {
  id           String    @id @default(cuid())
  openId       String    @unique // TikTok user open_id
  displayName  String
  avatarUrl    String?
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model BrandKnowledge {
  id        String   @id @default(cuid())
  category  String
  title     String
  content   String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BrandKit {
  id             String        @id @default(cuid())
  facebookPageId String?       @unique
  facebookPage   FacebookPage? @relation(fields: [facebookPageId], references: [id])
  logoUrl        String?
  primaryColor   String        @default("#2d6a4f")
  accentColor    String        @default("#40c074")
  fontStyle      String        @default("elegant")
  spaName        String?
  tagline        String?
  updatedAt      DateTime      @updatedAt
}

model Service {
  id             String        @id @default(cuid())
  facebookPageId String?
  facebookPage   FacebookPage? @relation(fields: [facebookPageId], references: [id])
  name           String
  description    String?
  price          String?
  category       String?
  duration       String?
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  posts          Post[]
}

model StyleSample {
  id             String        @id @default(cuid())
  facebookPageId String?
  facebookPage   FacebookPage? @relation(fields: [facebookPageId], references: [id])
  content        String
  platform       String        @default("facebook")
  likes          Int           @default(0)
  comments       Int           @default(0)
  shares         Int           @default(0)
  source         String        @default("manual")
  learningStatus String        @default("approved")
  createdAt      DateTime      @default(now())
}

model StyleProfile {
  id             String        @id @default(cuid())
  facebookPageId String?       @unique
  facebookPage   FacebookPage? @relation(fields: [facebookPageId], references: [id])
  profile        String
  updatedAt      DateTime      @updatedAt
}

model HumanVoiceProfile {
  id             String        @id @default(cuid())
  facebookPageId String?       @unique
  facebookPage   FacebookPage? @relation(fields: [facebookPageId], references: [id], onDelete: Restrict)
  rules          String
  preferredWords String        @default("[]")
  avoidedWords   String        @default("[]")
  approvedEdits  Int           @default(0)
  confidence     Float         @default(0)
  autoApply      Boolean       @default(false)
  updatedAt      DateTime      @updatedAt
  createdAt      DateTime      @default(now())
}

model VisualProfile {
  id                String        @id @default(cuid())
  facebookPageId    String?       @unique
  facebookPage      FacebookPage? @relation(fields: [facebookPageId], references: [id])
  promptRules       String?
  preferredPalettes String        @default("[]")
  preferredPresets  String        @default("[]")
  preferredSubjects String        @default("[]")
  avoidedElements   String        @default("[]")
  approvedImages    Int           @default(0)
  rejectedImages    Int           @default(0)
  confidence        Float         @default(0)
  autoApply         Boolean       @default(true)
  trainingSamples   Int           @default(0)
  lastTrainedAt     DateTime?
  updatedAt         DateTime      @updatedAt
  createdAt         DateTime      @default(now())
}

model StaffVisualProfile {
  id                  String              @id @default(cuid())
  facebookPageId      String?
  facebookPage        FacebookPage?       @relation(fields: [facebookPageId], references: [id])
  name                String
  role                String?
  gender              String              @default("female")
  referenceImageUrl   String?
  referenceStorageKey String?
  promptDescriptor    String
  appearanceNotes     String?
  uniformNotes        String?
  usageNotes          String?
  consentStatus       String              @default("consented")
  isActive            Boolean             @default(true)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  samples             StaffVisualSample[]
  generations         ImageGeneration[]

  @@index([facebookPageId, isActive])
  @@index([consentStatus, isActive])
}

model StaffVisualSample {
  id         String             @id @default(cuid())
  staffId    String
  staff      StaffVisualProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)
  imageUrl   String
  storageKey String?
  angle      String?
  expression String?
  outfit     String?
  notes      String?
  isPrimary  Boolean            @default(false)
  createdAt  DateTime           @default(now())

  @@index([staffId, isPrimary])
}

model Post {
  id                String               @id @default(cuid())
  caption           String
  hashtags          String?
  imageUrl          String?
  imagePrompt       String?
  platform          String               @default("facebook")
  postType          String               @default("service")
  tone              String               @default("friendly")
  status            String               @default("draft")
  scheduledAt       DateTime?
  publishedAt       DateTime?
  fbPostId          String?
  fbAdId            String?
  fbCampaignId      String?
  igPostId          String? // Instagram media id
  tiktokVideoId     String? // TikTok video id
  qualityScore      Int?
  qualityNotes      String?
  abGroupId         String?
  serviceId         String?
  bulkPlanId        String?
  facebookPageId    String?
  service           Service?             @relation(fields: [serviceId], references: [id])
  bulkPlan          BulkPlan?            @relation(fields: [bulkPlanId], references: [id])
  facebookPage      FacebookPage?        @relation(fields: [facebookPageId], references: [id])
  analytics         PostAnalytics?
  review            ContentReview?
  comments          PostComment[]
  generations       ContentGeneration[]
  imageGenerations  ImageGeneration[]
  adsOperations     AdsCreateOperation[]
  publishOperations PublishOperation[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
}

model AdsCreateOperation {
  id             String       @id @default(cuid())
  idempotencyKey String       @unique
  requestHash    String
  postId         String
  post           Post         @relation(fields: [postId], references: [id], onDelete: Restrict)
  facebookPageId String
  facebookPage   FacebookPage @relation(fields: [facebookPageId], references: [id], onDelete: Restrict)
  fbPageId       String
  adAccountId    String
  currency       String
  actorId        String
  input          String
  status         String       @default("pending")
  currentStep    String       @default("campaign")
  campaignId     String?
  adSetId        String?
  imageHash      String?
  creativeId     String?
  adId           String?
  attempt        Int          @default(0)
  leaseOwner     String?
  leaseUntil     DateTime?
  error          String?
  completedAt    DateTime?
  reconciledAt   DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status, updatedAt])
  @@index([facebookPageId, createdAt])
  @@index([adAccountId, createdAt])
  @@index([postId, createdAt])
}

model PublishOperation {
  id                  String                  @id @default(cuid())
  idempotencyKey      String                  @unique
  requestHash         String
  postId              String
  post                Post                    @relation(fields: [postId], references: [id], onDelete: Restrict)
  facebookPageId      String?
  facebookPage        FacebookPage?           @relation(fields: [facebookPageId], references: [id], onDelete: Restrict)
  source              String
  revision            Int?
  actorId             String?
  payload             String
  status              String                  @default("pending")
  attempt             Int                     @default(0)
  leaseOwner          String?
  leaseUntil          DateTime?
  error               String?
  completedAt         DateTime?
  reconciliationAt    DateTime?
  reconciliationNotes String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  channelAttempts     PublishChannelAttempt[]

  @@unique([postId, requestHash])
  @@index([status, leaseUntil])
  @@index([postId, createdAt])
  @@index([facebookPageId, createdAt])
}

model PublishChannelAttempt {
  id                 String           @id @default(cuid())
  operationId        String
  operation          PublishOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  channel            String
  attempt            Int
  status             String           @default("pending")
  providerCheckpoint String?
  externalId         String?
  error              String?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([operationId, channel, attempt])
  @@index([operationId, channel, status])
  @@index([status, updatedAt])
}

model ContentGeneration {
  id             String        @id @default(cuid())
  postId         String?
  post           Post?         @relation(fields: [postId], references: [id], onDelete: SetNull)
  facebookPageId String?
  promptVersion  String        @default("human-v1")
  model          String?
  mode           String        @default("quick")
  narrator       String        @default("brand")
  brief          String
  strategy       String?
  draftCaption   String
  editorCaption  String
  finalCaption   String
  hashtags       String?
  humanScore     Int           @default(0)
  scoreDetails   String
  userAccepted   Boolean?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  edits          ContentEdit[]

  @@index([facebookPageId, createdAt])
  @@index([postId])
}

model ContentEdit {
  id              String            @id @default(cuid())
  generationId    String            @unique
  generation      ContentGeneration @relation(fields: [generationId], references: [id], onDelete: Cascade)
  originalContent String
  finalContent    String
  changeRatio     Float
  changeSummary   String?
  acceptedVoice   Boolean           @default(false)
  createdAt       DateTime          @default(now())
}

model ImageGeneration {
  id                 String              @id @default(cuid())
  postId             String?
  post               Post?               @relation(fields: [postId], references: [id], onDelete: SetNull)
  facebookPageId     String?
  serviceId          String?
  promptVersion      String              @default("visual-v1")
  model              String?
  preset             String              @default("organic")
  format             String              @default("feed")
  sourceCaption      String?
  visualBrief        String?
  staffProfileId     String?
  staffProfile       StaffVisualProfile? @relation(fields: [staffProfileId], references: [id], onDelete: SetNull)
  parentGenerationId String?
  parentGeneration   ImageGeneration?    @relation("ImageVariants", fields: [parentGenerationId], references: [id], onDelete: SetNull)
  variants           ImageGeneration[]   @relation("ImageVariants")
  batchId            String?
  variantIndex       Int                 @default(0)
  referenceMode      String              @default("none")
  referenceSampleIds String              @default("[]")
  prompt             String
  negativePrompt     String?
  finalPrompt        String
  imageUrl           String
  originalImageUrl   String?
  storageKey         String?
  overlayTemplate    String              @default("none")
  qualityScore       Int                 @default(0)
  promptScore        Int                 @default(0)
  visionScore        Int?
  visionDetails      String?
  generationStatus   String              @default("completed")
  retryCount         Int                 @default(0)
  latencyMs          Int?
  estimatedCostUsd   Float?
  scoreDetails       String
  userAccepted       Boolean?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  feedback           ImageFeedback[]

  @@index([facebookPageId, createdAt])
  @@index([postId])
  @@index([batchId, variantIndex])
  @@index([parentGenerationId])
  @@index([staffProfileId, createdAt])
  @@index([preset, format])
}

model ImageFeedback {
  id           String          @id @default(cuid())
  generationId String
  generation   ImageGeneration @relation(fields: [generationId], references: [id], onDelete: Cascade)
  rating       String
  notes        String?
  createdAt    DateTime        @default(now())

  @@index([generationId, createdAt])
  @@index([rating, createdAt])
}

model BulkPlan {
  id             String        @id @default(cuid())
  name           String
  month          Int
  year           Int
  status         String        @default("draft")
  facebookPageId String?
  facebookPage   FacebookPage? @relation(fields: [facebookPageId], references: [id], onDelete: Restrict)
  posts          Post[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([facebookPageId, createdAt])
}

model ContentReview {
  id         String   @id @default(cuid())
  postId     String   @unique
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  status     String // "pass" | "warn" | "fail"
  score      Int      @default(0) // 0-100
  issues     String // JSON: [{ type, severity, message, suggestion }]
  reviewer   String   @default("ai_reviewer")
  reviewedAt DateTime @default(now())
}

model PostAnalytics {
  id             String   @id @default(cuid())
  postId         String   @unique
  post           Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  // Facebook metrics
  reach          Int      @default(0)
  likes          Int      @default(0)
  comments       Int      @default(0)
  shares         Int      @default(0)
  clicks         Int      @default(0)
  // Instagram metrics
  igReach        Int      @default(0)
  igLikes        Int      @default(0)
  igComments     Int      @default(0)
  igSaved        Int      @default(0)
  igImpressions  Int      @default(0)
  // TikTok metrics
  tiktokViews    Int      @default(0)
  tiktokLikes    Int      @default(0)
  tiktokComments Int      @default(0)
  tiktokShares   Int      @default(0)
  fetchedAt      DateTime @default(now())
}

model PostComment {
  id             String        @id @default(cuid())
  postId         String
  post           Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  facebookPageId String?
  facebookPage   FacebookPage? @relation(fields: [facebookPageId], references: [id])
  fbCommentId    String?       @unique
  authorName     String
  content        String
  sentiment      String?
  isReplied      Boolean       @default(false)
  autoReply      String?
  isAlert        Boolean       @default(false)
  createdAt      DateTime      @default(now())
}

model CommentRule {
  id             String        @id @default(cuid())
  facebookPageId String?
  facebookPage   FacebookPage? @relation(fields: [facebookPageId], references: [id], onDelete: Restrict)
  trigger        String
  reply          String
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())

  @@index([facebookPageId, createdAt])
}

model MessageRule {
  id        String   @id @default(cuid())
  trigger   String // keyword hoặc regex pattern
  reply     String // text trả lời cố định
  matchMode String   @default("contains") // contains | exact | regex
  priority  Int      @default(0) // rule cao hơn match trước
  channel   String   @default("both") // facebook | zalo | both
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model InboxMessage {
  id             String        @id @default(cuid())
  senderId       String
  senderName     String
  message        String
  fbMessageId    String?       @unique
  reply          String?
  isRead         Boolean       @default(false)
  isAutoReply    Boolean       @default(false)
  customerId     String?
  facebookPageId String?
  customer       Customer?     @relation(fields: [customerId], references: [id])
  facebookPage   FacebookPage? @relation(fields: [facebookPageId], references: [id])
  createdAt      DateTime      @default(now())
}

model AppointmentRequest {
  id          String    @id @default(cuid())
  name        String
  phone       String?
  service     String?
  preferredAt String?
  note        String?
  status      String    @default("pending")
  source      String    @default("inbox")
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Customer {
  id            String               @id @default(cuid())
  name          String
  phone         String?
  fbId          String?
  fbName        String?
  email         String?
  birthday      String?
  segment       String               @default("new")
  leadScore     Int                  @default(0)
  lastContact   DateTime?
  note          String?
  tags          String?
  npsScore      Int?
  npsAt         DateTime?
  // CLV & Churn (cached, updated by cron)
  clvTotal      Int? // tổng doanh thu VND
  clvTier       String? // low | mid | high | premium
  churnRisk     String? // low | medium | high
  rfmScore      Int? // 1-125
  avgVisitDays  Int? // trung bình số ngày giữa 2 lần visit
  lastBookingAt DateTime?
  clvUpdatedAt  DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  messages      InboxMessage[]
  appointments  AppointmentRequest[]
  notes         CustomerNote[]
  careMessages  CareMessage[]
}

model CustomerNote {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  content    String
  type       String   @default("note")
  createdAt  DateTime @default(now())
}

model CareMessage {
  id          String    @id @default(cuid())
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id])
  type        String
  content     String
  platform    String    @default("facebook")
  scheduledAt DateTime?
  sentAt      DateTime?
  status      String    @default("pending")
  createdAt   DateTime  @default(now())
}

model Competitor {
  id          String           @id @default(cuid())
  fbPageId    String           @unique // public page ID (e.g. "12345...")
  name        String // tên đối thủ (do user nhập)
  notes       String? // ghi chú nội bộ
  accessToken String? // optional — page access token nếu có
  isActive    Boolean          @default(true)
  lastFetchAt DateTime?
  createdAt   DateTime         @default(now())
  posts       CompetitorPost[]
}

model CompetitorPost {
  id              String     @id @default(cuid())
  competitorId    String
  competitor      Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  fbPostId        String     @unique
  message         String
  likes           Int        @default(0)
  comments        Int        @default(0)
  shares          Int        @default(0)
  engagementScore Int        @default(0)
  viralLevel      String     @default("low")
  detectedTopic   String?
  contentFormat   String?
  detectedService String?
  hookType        String?
  offerType       String?
  ctaType         String?
  aiSummary       String?
  learningStatus  String     @default("approved")
  analyzedAt      DateTime?
  publishedAt     DateTime
  fetchedAt       DateTime   @default(now())

  @@index([learningStatus, publishedAt])
  @@index([viralLevel, publishedAt])
  @@index([detectedTopic])
}

model CompetitorMemory {
  id                 String    @id @default(cuid())
  windowDays         Int       @default(30)
  topTopics          String    @default("[]")
  topServices        String    @default("[]")
  topFormats         String    @default("[]")
  topHooks           String    @default("[]")
  commonOffers       String    @default("[]")
  competitorMomentum String    @default("[]")
  counterPositioning String?
  recommendations    String    @default("[]")
  sampleCount        Int       @default(0)
  confidence         Float     @default(0)
  lastAnalyzedPostAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([updatedAt])
}

model IntelligenceSignal {
  id        String   @id @default(cuid())
  source    String // "fb_ads_library" | "google_trends" | "fb_competitor" | "manual"
  topic     String // "triệt lông bikini", "facial Hàn Quốc"
  volume    Float // search index | active ads count | likes
  trend     String   @default("stable") // "rising" | "stable" | "falling"
  details   String? // JSON: raw data
  fetchedAt DateTime @default(now())

  @@index([source, topic])
  @@index([trend, fetchedAt])
}

model SpaStory {
  id             String   @id @default(cuid())
  facebookPageId String?
  type           String   @default("testimonial") // testimonial | result | event | staff | behind-scenes
  customerName   String?
  content        String
  service        String?
  imageUrl       String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model RealtimeAlert {
  id            String   @id @default(cuid())
  type          String // "revenue_drop" | "negative_spike" | "ad_anomaly" | "lead_pile"
  signal        String // detail string
  severity      String // "warning" | "critical"
  workflowRunId String? // if a workflow was triggered
  acknowledged  Boolean  @default(false)
  detectedAt    DateTime @default(now())

  @@index([type, detectedAt])
  @@index([acknowledged])
}

model WorkflowRun {
  id          String    @id @default(cuid())
  name        String // "revenue_drop" | "competitor_surge" | "engagement_drop"
  trigger     String // signal label
  context     String // full context
  steps       String // JSON: [{ agent, label, input, output, status, durationMs }]
  plan        String? // CEO synthesis output
  status      String    @default("running") // running | completed | failed
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([name, startedAt])
  @@index([status])
}

model OrchestratorRun {
  id         String   @id @default(cuid())
  runAt      DateTime @default(now())
  signals    String // JSON state snapshot
  priorities String // JSON [{ agent, score, reason }]
  actions    String // JSON actions taken/queued
  mode       String   @default("recommend") // recommend | auto
}

model CEODecision {
  id             String    @id @default(cuid())
  date           DateTime  @default(now())
  topic          String // chủ đề (dùng để fuzzy match khi truy vấn)
  topicKey       String // normalized: lowercase + keywords (cho query nhanh)
  context        String // bối cảnh input
  synthesis      String // quyết định cuối từ Council
  debate         String? // JSON turns transcript
  source         String    @default("council") // council | morning_brief | content_research | ab_test | manual
  // Outcome tracking
  outcomeCheckAt DateTime? // khi nào sẽ check kết quả (date + N ngày)
  outcomeMetric  String? // metric đo (revenue | leads | engagement)
  outcomeBefore  Float? // baseline trước
  outcomeAfter   Float? // sau X ngày
  outcomeStatus  String? // "success" | "fail" | "neutral" | "pending"
  outcomeNotes   String? // AI nhận định
  createdAt      DateTime  @default(now())

  @@index([topicKey])
  @@index([outcomeStatus])
}

model RevenueForecast {
  id             String   @id @default(cuid())
  generatedAt    DateTime @default(now())
  horizonDays    Int
  scenario       String   @default("baseline") // baseline | ads_2x | promo_30 | tet_boost
  forecast       String // JSON array: [{ date, predicted, lowerBound, upperBound, factors }]
  totalPredicted Int // sum of predicted across horizon (VND)
  confidence     Float    @default(0.5) // 0.0-1.0
  notes          String? // AI Council reasoning
}

model MorningBrief {
  id          String   @id @default(cuid())
  date        String   @unique
  summary     String // CEO synthesis
  actions     String // JSON BriefAction[] — legacy compat
  debate      String? // JSON CouncilTurn[]
  subReports  String? // JSON { intelligence, ads, content, sales }
  assignments String? // JSON Assignment[]
  dismissed   Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model HolidayEvent {
  id           String   @id @default(cuid())
  name         String
  date         String
  description  String?
  isVietnamese Boolean  @default(true)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model SocialAlert {
  id        String   @id @default(cuid())
  type      String
  content   String
  source    String
  severity  String   @default("low")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Lead {
  id             String             @id @default(cuid())
  customerId     String?
  name           String
  phone          String?
  source         String             @default("facebook")
  score          Int                @default(0)
  stage          String             @default("cold")
  service        String?
  lastAction     String?
  nextFollowUp   DateTime?
  note           String?
